<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#000000">
    
        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:background="#8B5CF6"
            android:gravity="center_vertical">
    
            <TextView
                android:id="@+id/btn_close_projects"
                android:layout_width="55dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />
    
            <com.kenzglobe.debugmate.AppBoldTextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="My Projects"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
    
            <TextView
                android:id="@+id/btn_show_hidden"
                android:layout_width="55dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />
                
        </LinearLayout>
            
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD" />
    
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
    
            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/empty_projects_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">
    
                <TextView
                    android:id="@+id/empty_icon_projects"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="80sp"
                    android:textColor="#333333" />
    
                <com.kenzglobe.debugmate.AppBoldTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="No projects yet"
                    android:textColor="#888888"
                    android:textSize="18sp" />
    
            </LinearLayout>
    
            <!-- Project Grid -->
            <GridView
                android:id="@+id/project_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:numColumns="2"
                android:padding="8dp"
                android:horizontalSpacing="8dp"
                android:verticalSpacing="8dp"
                android:clipToPadding="false" />
                
        </FrameLayout>
        
    </LinearLayout>
    
    <com.kenzglobe.debugmate.AppBoldTextView
        android:id="@+id/workspace_btn"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginBottom="50dp"
        android:layout_gravity="center_horizontal|bottom"
        android:paddingHorizontal="20dp"
        android:gravity="center_vertical"
        android:background="@drawable/tab_active"
        android:text="Workspace"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:elevation="6dp" />

</FrameLayout>
