<?xml version="1.0" encoding="utf-8"?>
<RadioGroup xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp">

    <RadioButton
        android:id="@+id/radio_welcome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Welcome Screen"
        android:textColor="#FFFFFF"
        android:buttonTint="#8B5CF6"
        android:paddingVertical="8dp" />

    <RadioButton
        android:id="@+id/radio_last_folder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Last Opened Folder"
        android:textColor="#FFFFFF"
        android:buttonTint="#8B5CF6"
        android:paddingVertical="8dp" />

    <RadioButton
        android:id="@+id/radio_projects"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Projects Dashboard"
        android:textColor="#FFFFFF"
        android:buttonTint="#8B5CF6"
        android:paddingVertical="8dp" />

    <RadioButton
        android:id="@+id/radio_workspace"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Workspace"
        android:textColor="#FFFFFF"
        android:buttonTint="#8B5CF6"
        android:paddingVertical="8dp" />

</RadioGroup>
