<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp"
    android:background="@drawable/settings_section_bg"
    android:orientation="vertical"
    android:elevation="8dp">

    <!-- Refresh -->
    <LinearLayout
        android:id="@+id/opt_refresh"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="?android:attr/selectableItemBackground">

        <TextView
            android:id="@+id/icon_refresh"
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:textColor="#8B5CF6"
            android:textSize="16sp" />

        <com.kenzglobe.debugmate.AppTextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="Refresh Dashboard"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Export -->
    <LinearLayout
        android:id="@+id/opt_export"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="?android:attr/selectableItemBackground">

        <TextView
            android:id="@+id/icon_export"
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:textColor="#8B5CF6"
            android:textSize="16sp" />

        <com.kenzglobe.debugmate.AppTextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="Export Project Report"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Settings -->
    <LinearLayout
        android:id="@+id/opt_settings"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="?android:attr/selectableItemBackground">

        <TextView
            android:id="@+id/icon_settings"
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:textColor="#8B5CF6"
            android:textSize="16sp" />

        <com.kenzglobe.debugmate.AppTextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="Project Settings"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
