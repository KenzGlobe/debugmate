<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/editor_drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ========================================== -->
    <!-- MAIN EDITOR CONTENT                        -->
    <!-- ========================================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#8B5CF6">

        <!-- Editor Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:background="#8B5CF6"
            android:gravity="center_vertical">
        
            <TextView
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />
        
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:orientation="vertical">
                
                <TextView
                    android:id="@+id/editor_file_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="filename.java"
                    android:textColor="#FFFFFF"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="5dp" />
                
                <TextView
                    android:id="@+id/editor_file_path"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No file path."
                    android:textColor="#DFDFDF"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginStart="8dp" />
                    
            </LinearLayout>
            
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD" />

        <!-- TAB BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:background="#000000"
            android:gravity="center_vertical">
        
            <TextView
                android:id="@+id/side_bar"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:background="@drawable/sidebar_bg"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
            
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingLeft="5dp"
                android:scrollbars="none">
        
                <LinearLayout
                    android:id="@+id/tab_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
                    
            </HorizontalScrollView>
            
        </LinearLayout>

        <com.kenzglobe.debugmate.NoSelectionWebView
            android:id="@+id/code_editor_webview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingBottom="80dp"
            android:clipToPadding="false"
            android:background="#1E1E1E" />
            
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FFFFFF" />
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:orientation="horizontal"
            android:background="#8B5CF6">
            
            <TextView android:id="@+id/btn_save" style="@style/EditorBottomBarBtn" />
            <TextView android:id="@+id/btn_find" style="@style/EditorBottomBarBtn" />
            <TextView android:id="@+id/btn_undo" style="@style/EditorBottomBarBtn" />
            <TextView android:id="@+id/btn_redo" style="@style/EditorBottomBarBtn" />
            <TextView android:id="@+id/btn_run" style="@style/EditorBottomBarBtn" />
            
        </LinearLayout>
        
    </LinearLayout>

    <!-- ========================================== -->
    <!-- COLOR PICKER                               -->
    <!-- ========================================== -->
    <FrameLayout
        android:id="@+id/color_picker_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="20dp"
            android:background="@drawable/color_palette_bg"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:elevation="10dp"
            android:padding="16dp">
            
            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Insert Color"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                    
                <TextView
                    android:id="@+id/btn_close_palette"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#AAAAAA"
                    android:textSize="18sp" />
                    
            </LinearLayout>

            <!-- Grid of Colors -->
            <com.kenzglobe.debugmate.ColorPickerView
                android:id="@+id/color_picker_wheel"
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:layout_gravity="center_horizontal" />

            <!-- Preview and Hex text -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp">

                <View
                    android:id="@+id/color_preview"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="#8B5CF6" />

                <EditText
                    android:id="@+id/color_hex_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="#8B5CF6"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:backgroundTint="#8B5CF6"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:maxLength="7" />
                    
            </LinearLayout>

            <!-- Insert Button -->
            <Button
                android:id="@+id/btn_insert_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Insert Color"
                android:backgroundTint="#8B5CF6"
                android:textColor="#FFFFFF" />
            
        </LinearLayout>
        
    </FrameLayout>

    <!-- ========================================== -->
    <!-- FILE TREE SIDEBAR                          -->
    <!-- ========================================== -->
    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#262626"
        android:orientation="vertical">

        <!-- Sidebar Header -->
        <LinearLayout
            android:id="@+id/sidebar_header"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#8B5CF6"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tree_up_btn"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:clickable="true"
                android:focusable="true" />

            <com.kenzglobe.debugmate.AppBoldTextView
                android:id="@+id/tree_root_name"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="Explorer"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:singleLine="true"
                android:ellipsize="end" />
                
            <View
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:layout_marginVertical="10dp"
                android:background="#DDDDDD" />

            <TextView
                android:id="@+id/drop_activity_bar_btn"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
                
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DDDDDD" />
            
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ========================================== -->
            <!-- PANEL 1: THE MENU (Activity Bar)           -->
            <!-- ========================================== -->
            <LinearLayout
                android:id="@+id/activity_bar_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#262626"
                android:orientation="vertical">
                
                <LinearLayout
                    android:id="@+id/nav_explorer"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/nav_explorer_ic"
                        android:layout_width="50dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textSize="18sp"
                        android:textColor="#8B5CF6" />

                    <com.kenzglobe.debugmate.AppTextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="Explorer"
                        android:textSize="15sp"
                        android:textColor="#FFFFFF" />
                        
                </LinearLayout>
                
                <LinearLayout
                    android:id="@+id/nav_search"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/nav_search_ic"
                        android:layout_width="50dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textSize="18sp"
                        android:textColor="#8B5CF6" />

                    <com.kenzglobe.debugmate.AppTextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="Search"
                        android:textSize="15sp"
                        android:textColor="#FFFFFF" />
                        
                </LinearLayout>
                
                <LinearLayout
                    android:id="@+id/nav_git"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/nav_git_ic"
                        android:layout_width="50dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textSize="18sp"
                        android:textColor="#8B5CF6" />

                    <com.kenzglobe.debugmate.AppTextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="Source Control"
                        android:textSize="15sp"
                        android:textColor="#FFFFFF" />
                        
                </LinearLayout>
                
                <LinearLayout
                    android:id="@+id/nav_run"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/nav_run_ic"
                        android:layout_width="50dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textSize="18sp"
                        android:textColor="#8B5CF6" />

                    <com.kenzglobe.debugmate.AppTextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="Run and Debug"
                        android:textSize="15sp"
                        android:textColor="#FFFFFF" />
                        
                </LinearLayout>
                
                <LinearLayout
                    android:id="@+id/nav_extensions"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/nav_extensions_ic"
                        android:layout_width="50dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textSize="18sp"
                        android:textColor="#8B5CF6" />

                    <com.kenzglobe.debugmate.AppTextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="Extensions"
                        android:textSize="15sp"
                        android:textColor="#FFFFFF" />
                        
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                
                <LinearLayout
                    android:id="@+id/nav_accounts"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/nav_accounts_ic"
                        android:layout_width="50dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textSize="18sp"
                        android:textColor="#8B5CF6" />

                    <com.kenzglobe.debugmate.AppTextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="Accounts"
                        android:textSize="15sp"
                        android:textColor="#FFFFFF" />
                        
                </LinearLayout>
                    
            </LinearLayout>

            <!-- ========================================== -->
            <!-- PANEL 2: THE FILE EXPLORER                 -->
            <!-- ========================================== -->
            <LinearLayout
                android:id="@+id/panel_explorer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="#262626"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:elevation="6dp">

                    <TextView
                        android:id="@+id/settings_btn"
                        style="@style/fileTreeHeaderBtns" />

                    <TextView
                        android:id="@+id/create_folder"
                        style="@style/fileTreeHeaderBtns" />

                    <TextView
                        android:id="@+id/create_file"
                        style="@style/fileTreeHeaderBtns" />

                    <TextView
                        android:id="@+id/palette"
                        style="@style/fileTreeHeaderBtns"
                        android:text="🎨" />
                        
                </LinearLayout>

                <ListView
                    android:id="@+id/tree_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:divider="@null"
                    android:dividerHeight="0dp" />
                    
            </LinearLayout>

            <!-- ========================================== -->
            <!-- PANEL 3: SOURCE CONTROL (Git)              -->
            <!-- ========================================== -->
            <LinearLayout
                android:id="@+id/panel_source_control"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Status Refresh Area -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <Button
                        android:id="@+id/btn_git_status"
                        android:layout_width="match_parent"
                        android:layout_height="35dp"
                        android:backgroundTint="#262626"
                        android:text="Refresh Status"
                        android:textColor="#8B5CF6"
                        android:textSize="12sp" />
                    
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" />

                <!-- List of Changed Files -->
                <ListView
                    android:id="@+id/git_file_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:divider="@null"
                    android:dividerHeight="0dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" />

                <!-- Commit Area -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">
                    
                    <com.kenzglobe.debugmate.AppEditText
                        android:id="@+id/git_commit_message"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:background="@drawable/edittext_bg"
                        android:gravity="top|start"
                        android:hint="Message (Commit)"
                        android:padding="8dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#888888"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_git_add"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:backgroundTint="#D29922"
                            android:text="Add"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                            
                        <Button
                            android:id="@+id/btn_git_commit"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:backgroundTint="#3FB950"
                            android:text="Commit"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btn_git_push"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:backgroundTint="#58A6FF"
                            android:text="Push"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                            
                    </LinearLayout>
                    
                </LinearLayout>
                
            </LinearLayout>
            
        </FrameLayout>

        <!-- BOTTOM PANEL (Keep your existing font size/goto line code here) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#666666" />
            
        <LinearLayout
            android:id="@+id/bottom_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#202020"
            android:orientation="vertical"
            android:elevation="6dp">
            
            <!-- CHANGE FONT-SIZE SECTION -->
            <com.kenzglobe.debugmate.AppBoldTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="Font size"
                android:textSize="12sp"
                android:textColor="#BBBBBB" />
                
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <Button
                    android:id="@+id/reduce_font_size"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="5dp"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="#8B5CF6"
                    android:textColor="#FFFFFF" />
                
                <com.kenzglobe.debugmate.AppTextView
                    android:id="@+id/current_font_size"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginVertical="8dp"
                    android:layout_marginHorizontal="5dp"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/color_palette_bg"
                    android:textColor="#FFFFFF" />
                
                <Button
                    android:id="@+id/increase_font_size"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="5dp"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="#8B5CF6"
                    android:textColor="#FFFFFF" />
                
            </LinearLayout>
            
            <View
                android:layout_width="200dp"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="#666666"
                android:layout_gravity="center" />

            <!-- GO-TO-LINE SECTION -->
            <com.kenzglobe.debugmate.AppBoldTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="Go to Line"
                android:textSize="12sp"
                android:textColor="#BBBBBB" />
    
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="5dp"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/goto_line_input"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/color_palette_bg"
                    android:hint="Line number..."
                    android:inputType="number"
                    android:paddingHorizontal="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_goto_line"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#8B5CF6"
                    android:text="Go"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
        
            </LinearLayout>
            
        </LinearLayout>
        
    </LinearLayout>

</android.support.v4.widget.DrawerLayout>
