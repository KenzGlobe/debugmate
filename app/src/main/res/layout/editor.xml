<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#8B5CF6">

    <!-- Editor Top Bar -->
	<LinearLayout
	    android:layout_width="match_parent"
	    android:layout_height="40dp"
	    android:orientation="horizontal"
	    android:background="#8B5CF6"
	    android:gravity="center_vertical">
	
	    <!-- Back Button -->
	    <TextView
	        android:id="@+id/btn_back"
	        android:layout_width="40dp"
	        android:layout_height="match_parent"
	        android:gravity="center"
	        android:textColor="#FFFFFF"
	        android:textSize="22sp" />
	
	    <!-- File Name -->
		<LinearLayout
		    android:layout_width="match_parent"
		    android:layout_height="match_parent"
		    android:layout_marginEnd="5dp"
		    android:orientation="vertical">
		    
		    <TextView
		        android:id="@+id/editor_file_name"
		        android:layout_width="match_parent"
		        android:layout_height="wrap_content"
		        android:text="filename.java"
		        android:textColor="#FFFFFF"
		        android:textSize="14.5sp"
		        android:textStyle="bold"
		        android:singleLine="true"
		        android:ellipsize="end"
		        android:layout_marginStart="8dp"
		        android:layout_marginTop="5dp" />
		    
		    <TextView
		        android:id="@+id/editor_file_path"
		        android:layout_width="match_parent"
		        android:layout_height="wrap_content"
		        android:text="No file path."
		        android:textColor="#DFDFDF"
		        android:textSize="10sp"
		        android:singleLine="true"
		        android:ellipsize="end"
		        android:layout_marginStart="8dp" />
	        
	    </LinearLayout>
	        
	</LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDDDDD" />

    <!-- TAB BAR -->
	<LinearLayout
	    android:layout_width="match_parent"
	    android:layout_height="40dp"
	    android:orientation="horizontal"
	    android:background="#202020"
	    android:gravity="center_vertical">
	
	    <TextView
	        android:id="@+id/side_bar"
	        android:layout_width="40dp"
	        android:layout_height="match_parent"
	        android:background="@drawable/sidebar_bg"
	        android:gravity="center"
	        android:textColor="#FFFFFF"
	        android:textSize="20sp" />
	    
	    <HorizontalScrollView
	        android:layout_width="match_parent"
	        android:layout_height="match_parent"
	        android:paddingLeft="5dp"
	        android:scrollbars="none">
	
	        <LinearLayout
	            android:id="@+id/tab_container"
	            android:layout_width="match_parent"
	            android:layout_height="match_parent"
	            android:gravity="center_vertical"
	            android:orientation="horizontal" />
	            
	    </HorizontalScrollView>
	    
	</LinearLayout>

	<!-- The Code Area (Handled by WebView) -->
    <com.kenzglobe.debugmate.NoSelectionWebView
        android:id="@+id/code_editor_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1E1E1E" />
    
	<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:orientation="horizontal"
        android:background="#8B5CF6">

        <!-- Save -->
        <TextView
            android:id="@+id/btn_save"
            style="@style/EditorBottomBarBtn" />

        <!-- Find / Search -->
        <TextView
            android:id="@+id/btn_find"
            style="@style/EditorBottomBarBtn" />
    
        <!-- Undo -->
        <TextView
            android:id="@+id/btn_undo"
            style="@style/EditorBottomBarBtn" />

        <!-- Redo -->
        <TextView
            android:id="@+id/btn_redo"
            style="@style/EditorBottomBarBtn" />

        <!-- Run -->
        <TextView
            android:id="@+id/btn_run"
            style="@style/EditorBottomBarBtn" />

    </LinearLayout>

</LinearLayout>
