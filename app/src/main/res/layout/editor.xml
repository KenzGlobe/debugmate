<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#8B5CF6">

    <!-- Editor Top Bar -->
	<LinearLayout
	    android:layout_width="match_parent"
	    android:layout_height="40dp"
	    android:orientation="horizontal"
	    android:background="#8B5CF6"
	    android:gravity="center_vertical">
	
	    <!-- Back Button -->
	    <TextView
	        android:id="@+id/btn_back"
	        android:layout_width="40dp"
	        android:layout_height="match_parent"
	        android:gravity="center"
	        android:textColor="#FFFFFF"
	        android:textSize="22sp" />
	
	    <!-- File Name -->
		<LinearLayout
		    android:layout_width="0dp"
		    android:layout_height="match_parent"
		    android:layout_weight="1"
		    android:orientation="vertical">
		    
		    <TextView
		        android:id="@+id/editor_file_name"
		        android:layout_width="match_parent"
		        android:layout_height="wrap_content"
		        android:text="filename.java"
		        android:textColor="#FFFFFF"
		        android:textSize="14.5sp"
		        android:textStyle="bold"
		        android:singleLine="true"
		        android:ellipsize="end"
		        android:layout_marginStart="8dp"
		        android:layout_marginTop="5dp" />
		    
		    <TextView
		        android:id="@+id/editor_file_path"
		        android:layout_width="match_parent"
		        android:layout_height="wrap_content"
		        android:text="No file path."
		        android:textColor="#DFDFDF"
		        android:textSize="10sp"
		        android:singleLine="true"
		        android:ellipsize="end"
		        android:layout_marginStart="8dp" />
	        
	    </LinearLayout>
	
	    <!-- Save Button -->
	    <TextView
	        android:id="@+id/btn_save"
	        android:layout_width="40dp"
	        android:layout_height="match_parent"
	        android:gravity="center"
	        android:textColor="#FFFFFF"
	        android:textSize="20sp" />
	        
	</LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDDDDD" />

    <!-- TAB BAR -->
    
	<LinearLayout
	    android:layout_width="match_parent"
	    android:layout_height="40dp"
	    android:orientation="horizontal"
	    android:background="#262626"
	    android:gravity="center_vertical">
	
	    <TextView
	        android:id="@+id/side_bar"
	        android:layout_width="40dp"
	        android:layout_height="match_parent"
	        android:background="@drawable/sidebar_bg"
	        android:gravity="center"
	        android:textColor="#FFFFFF"
	        android:textSize="20sp" />
	    
	    <HorizontalScrollView
	        android:layout_width="match_parent"
	        android:layout_height="wrap_content"
	        android:paddingLeft="5dp"
	        android:paddingVertical="5dp"
	        android:scrollbars="none">
	
	        <LinearLayout
	            android:id="@+id/tab_container"
	            android:layout_width="wrap_content"
	            android:layout_height="wrap_content"
	            android:orientation="horizontal" />
	            
	    </HorizontalScrollView>
	    
	</LinearLayout>

    <!-- The Code Area with Line Numbers -->
	<LinearLayout
	    android:layout_width="match_parent"
	    android:layout_height="match_parent"
	    android:orientation="horizontal"
	    android:background="#262626">
	
	    <!-- Line Numbers with ScrollView -->
		<ScrollView
		    android:id="@+id/scroll_numbers"
		    android:layout_width="wrap_content"
		    android:layout_height="match_parent"
		    android:scrollbars="none"
		    android:focusable="false"
		    android:focusableInTouchMode="false">
		    
		    <TextView
		        android:id="@+id/line_numbers"
		        android:layout_width="wrap_content"
		        android:layout_height="wrap_content"
		        android:background="#1A1A1A"
		        android:paddingLeft="8dp"
		        android:paddingRight="8dp"
		        android:gravity="top|end"
		        android:textColor="#8B5CF6"
		        android:textSize="10sp"
		        android:fontFamily="monospace"
		        android:text="1\n" />
		        
		</ScrollView>
	
	    <!-- The Code Editor -->
	    <EditText
	        android:id="@+id/code_editor"
	        android:layout_width="0dp"
	        android:layout_height="match_parent"
	        android:layout_weight="1"
	        android:background="@null"
	        android:gravity="top|start"
	        android:inputType="textMultiLine|textNoSuggestions"
	        android:imeOptions="flagNoExtractUi"
	        android:paddingLeft="2dp"
	        android:textColor="#FFFFFF"
	        android:textSize="10sp"
	        android:fontFamily="monospace"
	        android:scrollbars="horizontal|vertical"
	        android:scrollHorizontally="true" />
	        
	</LinearLayout>

</LinearLayout>
