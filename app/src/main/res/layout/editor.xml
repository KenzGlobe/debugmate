<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/editor_drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ========================================== -->
    <!-- MAIN EDITOR CONTENT                        -->
    <!-- ========================================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#8B5CF6">

        <!-- Editor Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:background="#8B5CF6"
            android:gravity="center_vertical">
        
            <TextView
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />
        
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:orientation="vertical">
                
                <TextView
                    android:id="@+id/editor_file_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="filename.java"
                    android:textColor="#FFFFFF"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="5dp" />
                
                <TextView
                    android:id="@+id/editor_file_path"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No file path."
                    android:textColor="#DFDFDF"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginStart="8dp" />
                    
            </LinearLayout>
            
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD" />

        <!-- TAB BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:background="#202020"
            android:gravity="center_vertical">
        
            <TextView
                android:id="@+id/side_bar"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:background="@drawable/sidebar_bg"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
            
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingLeft="5dp"
                android:scrollbars="none">
        
                <LinearLayout
                    android:id="@+id/tab_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
                    
            </HorizontalScrollView>
            
        </LinearLayout>

        <com.kenzglobe.debugmate.NoSelectionWebView
            android:id="@+id/code_editor_webview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#1E1E1E" />
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:orientation="horizontal"
            android:background="#8B5CF6">
            
            <TextView android:id="@+id/btn_save" style="@style/EditorBottomBarBtn" />
            <TextView android:id="@+id/btn_find" style="@style/EditorBottomBarBtn" />
            <TextView android:id="@+id/btn_undo" style="@style/EditorBottomBarBtn" />
            <TextView android:id="@+id/btn_redo" style="@style/EditorBottomBarBtn" />
            <TextView android:id="@+id/btn_run" style="@style/EditorBottomBarBtn" />
            
        </LinearLayout>
        
    </LinearLayout>

    <!-- ========================================== -->
    <!-- FILE TREE SIDEBAR                          -->
    <!-- ========================================== -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#262626"
        android:orientation="vertical">

        <!-- Sidebar Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#8B5CF6"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tree_up_btn"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <com.kenzglobe.debugmate.AppBoldTextView
                android:id="@+id/tree_root_name"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="Project Files"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
                
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD" />

        <!-- File List -->
        <ListView
            android:id="@+id/tree_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp" />
            
    </LinearLayout>

</android.support.v4.widget.DrawerLayout>
