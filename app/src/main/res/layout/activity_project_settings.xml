<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:orientation="horizontal"
        android:background="#8B5CF6"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btn_project_settings_back"
            android:layout_width="55dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <com.kenzglobe.debugmate.AppBoldTextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="Project Settings"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDDDDD" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Section: Security -->
            <com.kenzglobe.debugmate.AppBoldTextView
                style="@style/SettingTitle"
                android:text="Vault Security" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/settings_section_bg"
                android:elevation="6dp"
                android:paddingHorizontal="12dp">

                <!-- Change PIN -->
                <LinearLayout
                    android:id="@+id/row_change_pin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground">
                    
                    <com.kenzglobe.debugmate.AppBoldTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Change Vault PIN"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />
                    
                    <com.kenzglobe.debugmate.AppTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=">"
                        android:textColor="#888888"
                        android:textSize="16sp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" />

                <!-- Forget PIN -->
                <LinearLayout
                    android:id="@+id/row_forget_pin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground">
                    
                    <com.kenzglobe.debugmate.AppBoldTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Forget Vault PIN"
                        android:textColor="#F85149"
                        android:textSize="15sp" />
                    
                    <com.kenzglobe.debugmate.AppTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=">"
                        android:textColor="#F85149"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Section: Project Data -->
            <com.kenzglobe.debugmate.AppBoldTextView
                style="@style/SettingTitle"
                android:text="Project Data" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/settings_section_bg"
                android:elevation="6dp"
                android:paddingHorizontal="12dp">

                <!-- Clear Activity -->
                <LinearLayout
                    android:id="@+id/row_clear_activity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground">
                    
                    <com.kenzglobe.debugmate.AppBoldTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Clear Recent Activity"
                        android:textColor="#F85149"
                        android:textSize="15sp" />
                    
                    <com.kenzglobe.debugmate.AppTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=">"
                        android:textColor="#F85149"
                        android:textSize="16sp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" />

                <!-- Clear Stats -->
                <LinearLayout
                    android:id="@+id/row_clear_stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground">
                    
                    <com.kenzglobe.debugmate.AppBoldTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Clear Stats Cache"
                        android:textColor="#F85149"
                        android:textSize="15sp" />
                    
                    <com.kenzglobe.debugmate.AppTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=">"
                        android:textColor="#F85149"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
        
    </ScrollView>
    
</LinearLayout>