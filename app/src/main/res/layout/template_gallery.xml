<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/template_gallery_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#262626"
    android:elevation="15dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:background="#8B5CF6"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btn_close_templates"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="Choose a Template"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
                
        </LinearLayout>

        <!-- Search Bar -->
        <EditText
            android:id="@+id/template_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Search templates..."
            android:background="#333333"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:layout_margin="8dp" />

        <!-- Grid of Templates -->
        <GridView
            android:id="@+id/template_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="2"
            android:padding="8dp"
            android:horizontalSpacing="8dp"
            android:verticalSpacing="8dp"
            android:clipToPadding="false" />
            
    </LinearLayout>
    
</FrameLayout>
