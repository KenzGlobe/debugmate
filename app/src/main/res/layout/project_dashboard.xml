<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#000000">
        
        <!-- ACTION BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:background="#8B5CF6">
            
            <TextView
                android:id="@+id/back_btn"
                android:layout_width="55dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />
            
            <com.kenzglobe.debugmate.AppBoldTextView
                android:id="@+id/app_name"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="Project Dashboard"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
            
            <TextView
                android:id="@+id/option_btn"
                android:layout_width="55dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />
            
        </LinearLayout>
        
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FFFFFF" />
        
        <!-- DASHBOARD -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical">
                
                <!-- HEADER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    
                    <TextView
                        android:id="@+id/project_type_icon"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="center"
                        android:layout_marginVertical="20dp"
                        android:layout_marginHorizontal="10dp"
                        android:background="@drawable/color_888899_12radius_bg"
                        android:gravity="center"
                        android:textColor="#8B5CF6"
                        android:textSize="20sp" />
                    
                    <LinearLayout
                        android:id="@+id/header_info_layout"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">
                        
                        <com.kenzglobe.debugmate.AppBoldTextView
                            android:id="@+id/project_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="MyProject"
                            android:textSize="20sp"
                            android:textColor="#8B5CF6"
                            android:singleLine="true"
                            android:ellipsize="end" />
                        
                        <com.kenzglobe.debugmate.AppTextView
                            android:id="@+id/project_type"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="PROJECT"
                            android:textSize="14sp"
                            android:textColor="#FFFFFF"
                            android:singleLine="true" />
                        
                        <com.kenzglobe.debugmate.AppTextView
                            android:id="@+id/project_path"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="/storage/..."
                            android:textSize="12sp"
                            android:textColor="#888888"
                            android:singleLine="true"
                            android:ellipsize="middle" />
                        
                    </LinearLayout>
                    
                    <LinearLayout
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:layout_marginVertical="20dp"
                        android:orientation="vertical">
                        
                        <TextView
                            android:id="@+id/pinned_icon"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:textSize="14sp"
                            android:textColor="#888888"
                            android:gravity="center" />
                        
                        <TextView
                            android:id="@+id/hidden_icon"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:textSize="14sp"
                            android:textColor="#888888"
                            android:gravity="center" />
                        
                    </LinearLayout>
                    
                </LinearLayout>
                
                <!-- STATS GRID -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="2"
                    android:alignmentMode="alignMargins"
                    android:columnOrderPreserved="false"
                    android:useDefaultMargins="true">
                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="@drawable/settings_section_bg">
                        
                        <com.kenzglobe.debugmate.AppBoldTextView
                            android:id="@+id/tvFiles"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="20sp"
                            android:textColor="@android:color/white" />
                        
                        <com.kenzglobe.debugmate.AppTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Files"
                            android:textColor="#888888" />
                        
                    </LinearLayout>
                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="@drawable/settings_section_bg">
                        
                        <com.kenzglobe.debugmate.AppBoldTextView
                            android:id="@+id/tvFolders"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="20sp"
                            android:textColor="@android:color/white" />
                        
                        <com.kenzglobe.debugmate.AppTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Folders"
                            android:textColor="#888888" />
                        
                    </LinearLayout>
                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="@drawable/settings_section_bg">
                        
                        <com.kenzglobe.debugmate.AppBoldTextView
                            android:id="@+id/tvSize"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="20sp"
                            android:textColor="@android:color/white" />
                        
                        <com.kenzglobe.debugmate.AppTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Size"
                            android:textColor="#888888" />
                        
                    </LinearLayout>
                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="@drawable/settings_section_bg">
                        
                        <com.kenzglobe.debugmate.AppBoldTextView
                            android:id="@+id/tvModified"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="20sp"
                            android:textColor="@android:color/white" />
                        
                        <com.kenzglobe.debugmate.AppTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Modified"
                            android:textColor="#888888" />
                        
                    </LinearLayout>
                    
                </GridLayout>
                
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginVertical="8dp"
                    android:layout_marginHorizontal="25dp"
                    android:background="#1A1A1A" />
                
                <!-- QUICK ACTIONS -->
                <com.kenzglobe.debugmate.AppTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="15dp"
                    android:paddingStart="20dp"
                    android:text="Quick Actions"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF" />
                
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:rowCount="2"
                    android:alignmentMode="alignMargins"
                    android:columnOrderPreserved="false"
                    android:useDefaultMargins="true">
                    
                    <!-- Editor -->
                    <LinearLayout
                        android:id="@+id/quick_action_editor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="@drawable/settings_section_bg">
                        
                        <TextView
                            android:id="@+id/quick_action_editor_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="18sp"
                            android:textColor="#8B5CF6" />
                        
                        <com.kenzglobe.debugmate.AppTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Editor"
                            android:textColor="#888888" />
                        
                    </LinearLayout>
                    
                    <!-- Terminal -->
                    <LinearLayout
                        android:id="@+id/quick_action_terminal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="@drawable/settings_section_bg">
                        
                        <TextView
                            android:id="@+id/quick_action_terminal_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="18sp"
                            android:textColor="#8B5CF6" />
                        
                        <com.kenzglobe.debugmate.AppTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Terminal"
                            android:textColor="#888888" />
                        
                    </LinearLayout>
                    
                    <!-- Run -->
                    <LinearLayout
                        android:id="@+id/quick_action_run"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="@drawable/settings_section_bg">
                        
                        <TextView
                            android:id="@+id/quick_action_run_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="18sp"
                            android:textColor="#8B5CF6" />
                        
                        <com.kenzglobe.debugmate.AppTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Run"
                            android:textColor="#888888" />
                        
                    </LinearLayout>
                    
                    <!-- Git -->
                    <LinearLayout
                        android:id="@+id/quick_action_git"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="@drawable/settings_section_bg">
                        
                        <TextView
                            android:id="@+id/quick_action_git_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="18sp"
                            android:textColor="#8B5CF6" />
                        
                        <com.kenzglobe.debugmate.AppTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Git"
                            android:textColor="#888888" />
                        
                    </LinearLayout>
                    
                    <!-- Files -->
                    <LinearLayout
                        android:id="@+id/quick_action_files"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="@drawable/settings_section_bg">
                        
                        <TextView
                            android:id="@+id/quick_action_files_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="18sp"
                            android:textColor="#8B5CF6" />
                        
                        <com.kenzglobe.debugmate.AppTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Files"
                            android:textColor="#888888" />
                        
                    </LinearLayout>
                    
                    <!-- Settings -->
                    <LinearLayout
                        android:id="@+id/quick_action_settings"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="@drawable/settings_section_bg">
                        
                        <TextView
                            android:id="@+id/quick_action_settings_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="18sp"
                            android:textColor="#8B5CF6" />
                        
                        <com.kenzglobe.debugmate.AppTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Settings"
                            android:textColor="#888888" />
                        
                    </LinearLayout>
                    
                </GridLayout>
                
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginVertical="8dp"
                    android:layout_marginHorizontal="25dp"
                    android:background="#1A1A1A" />
                
                <!-- PROJECT INFORMATION -->
                <com.kenzglobe.debugmate.AppTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="15dp"
                    android:paddingStart="20dp"
                    android:text="Project Information"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF" />
                
                <!-- Main File Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:paddingHorizontal="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    
                    <com.kenzglobe.debugmate.AppTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Main file"
                        android:textColor="#888888" />
                    
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                    
                    <com.kenzglobe.debugmate.AppBoldTextView
                        android:id="@+id/main_file"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="#FFFFFF" />
                    
                </LinearLayout>
                
                <!-- Language Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:paddingHorizontal="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    
                    <com.kenzglobe.debugmate.AppTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Language"
                        android:textColor="#888888" />
                    
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                    
                    <com.kenzglobe.debugmate.AppBoldTextView
                        android:id="@+id/project_language"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="#FFFFFF" />
                    
                </LinearLayout>
                
                <!-- Dependencies Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:paddingHorizontal="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    
                    <com.kenzglobe.debugmate.AppTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dependencies"
                        android:textColor="#888888" />
                    
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                    
                    <com.kenzglobe.debugmate.AppBoldTextView
                        android:id="@+id/no_of_dependencies"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="#FFFFFF" />
                    
                </LinearLayout>
                
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginVertical="8dp"
                    android:layout_marginHorizontal="25dp"
                    android:background="#1A1A1A" />
                
                <!-- CODE HEALTH & README -->
                <com.kenzglobe.debugmate.AppTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="15dp"
                    android:paddingStart="20dp"
                    android:text="Code Health &amp; Docs"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF" />
                
                <!-- Stats Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:layout_marginBottom="10dp">
                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/settings_section_bg">
                        
                        <com.kenzglobe.debugmate.AppBoldTextView
                            android:id="@+id/tvLinesOfCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="20sp"
                            android:textColor="@android:color/white" />
                        
                        <com.kenzglobe.debugmate.AppTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lines of Code"
                            android:textColor="#888888" />
                        
                    </LinearLayout>
                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/settings_section_bg">
                        
                        <com.kenzglobe.debugmate.AppBoldTextView
                            android:id="@+id/tvTodos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="20sp"
                            android:textColor="@android:color/white" />
                        
                        <com.kenzglobe.debugmate.AppTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TODOs / FIXMEs"
                            android:textColor="#888888" />
                        
                    </LinearLayout>
                    
                </LinearLayout>
                
                <!-- README Card -->
                <LinearLayout
                    android:id="@+id/readme_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="5dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/settings_section_bg">
                    
                    <com.kenzglobe.debugmate.AppBoldTextView
                        android:id="@+id/readme_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="README.md"
                        android:textColor="#8B5CF6"
                        android:textSize="14sp" />
                    
                    <com.kenzglobe.debugmate.AppTextView
                        android:id="@+id/readme_preview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Loading..."
                        android:textColor="#AAAAAA"
                        android:textSize="12sp"
                        android:maxLines="4"
                        android:ellipsize="end" />
                    
                    <com.kenzglobe.debugmate.AppBoldTextView
                        android:id="@+id/readme_action_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Open README"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                    
                </LinearLayout>
                
                <!-- HEALTH WARNINGS -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginVertical="8dp"
                    android:layout_marginHorizontal="25dp"
                    android:background="#1A1A1A" />
                
                <com.kenzglobe.debugmate.AppTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="15dp"
                    android:paddingStart="20dp"
                    android:text="Health Warnings"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF" />
                
                <!-- Healthy Status (Visible when no warnings) -->
                <com.kenzglobe.debugmate.AppBoldTextView
                    android:id="@+id/tvHealthyStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginBottom="10dp"
                    android:padding="16dp"
                    android:background="@drawable/settings_section_bg"
                    android:text="✅ Project looks healthy!"
                    android:textColor="#3FB950"
                    android:visibility="gone" />
                
                <!-- Warnings Container -->
                <LinearLayout
                    android:id="@+id/health_warnings_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginBottom="10dp"
                    android:orientation="vertical" />
                
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginVertical="8dp"
                    android:layout_marginHorizontal="25dp"
                    android:background="#1A1A1A" />
                
                <!-- PROJECT STRUCTURE PREVIEW -->
                <com.kenzglobe.debugmate.AppTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="15dp"
                    android:paddingStart="20dp"
                    android:text="Project Structure"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF" />
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginBottom="10dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/settings_section_bg">
                    
                    <com.kenzglobe.debugmate.AppBoldTextView
                        android:id="@+id/tvProjectStructure"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="Loading..."
                        android:textColor="#AAAAAA"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp" />
                    
                    <com.kenzglobe.debugmate.AppBoldTextView
                        android:id="@+id/btnViewInFiles"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Open in File Manager"
                        android:textColor="#8B5CF6"
                        android:textSize="13sp" />
                    
                </LinearLayout>
                
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginVertical="8dp"
                    android:layout_marginHorizontal="25dp"
                    android:background="#1A1A1A" />
                
                <!-- RECENT ACTIVITY (Keep the Title & Dropdown Row) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    
                    <com.kenzglobe.debugmate.AppTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingVertical="15dp"
                        android:paddingStart="20dp"
                        android:text="Recent Activity"
                        android:textSize="16sp"
                        android:textColor="#FFFFFF" />
                    
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                    
                    <TextView
                        android:id="@+id/recent_activity_drop_btn"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:gravity="center"
                        android:textSize="30sp"
                        android:textColor="#888888" />
                    
                </LinearLayout>
                
                <!-- Empty State for Activity -->
                <com.kenzglobe.debugmate.AppTextView
                    android:id="@+id/tv_no_activity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="30dp"
                    android:gravity="center"
                    android:text="No recent activity."
                    android:textColor="#888888"
                    android:visibility="gone" />
                
                <!-- Visible Activities (Top 3) -->
                <LinearLayout
                    android:id="@+id/activity_container_visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
                
                <!-- Expandable Activities (4+) -->
                <LinearLayout
                    android:id="@+id/activity_container_hidden"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />
                
                <View android:layout_width="match_parent" android:layout_height="30dp" />
                
            </LinearLayout>
            
        </ScrollView>
        
    </LinearLayout>
    
</FrameLayout>
