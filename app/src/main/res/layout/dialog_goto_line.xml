<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_custom_popup"
    android:padding="5dp"
    android:elevation="8dp">

    <!-- Title -->
    <com.kenzglobe.debugmate.AppBoldTextView
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="Go to Line"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:gravity="center" />
        
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DDDDDD" />

    <!-- Input Field -->
    <com.kenzglobe.debugmate.AppEditText
        android:id="@+id/dialog_goto_input"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Enter line number..."
        android:inputType="number"
        android:textSize="15dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:textCursorDrawable="@drawable/cursor_white"
        android:background="@null"
        android:padding="10dp" />
        
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DDDDDD" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/dialog_goto_cancel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="Cancel"
            android:textColor="#AAAAAA"
            android:background="?android:attr/selectableItemBackground"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/dialog_goto_confirm"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="GO"
            android:textColor="#8B5CF6"
            android:background="?android:attr/selectableItemBackground"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
