<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Top Bar (Purple) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:background="#8B5CF6"
        android:gravity="center_vertical">

        <!-- Back Arrow -->
        <TextView
            android:id="@+id/btn_console_close"
            android:layout_width="55dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <!-- Title -->
        <com.kenzglobe.debugmate.AppBoldTextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="Python Console"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <!-- Clear Button -->
        <TextView
            android:id="@+id/btn_console_clear"
            android:layout_width="55dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />
            
    </LinearLayout>

    <!-- 1dp Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDDDDD" />

    <!-- Output Area -->
    <ScrollView
        android:id="@+id/console_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:fadeScrollbars="false">

        <TextView
            android:id="@+id/console_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#E6E6E6"
            android:textSize="13sp" />
            
    </ScrollView>

    <!-- Input Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1E1E1E"
        android:padding="8dp"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=">>> "
            android:textColor="#8B5CF6"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/console_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Type Python here..."
            android:imeOptions="actionSend"
            android:inputType="textNoSuggestions"
            android:textColor="#E6E6E6"
            android:textColorHint="#666666"
            android:textSize="14sp" />
            
    </LinearLayout>

    <!-- Hidden WebView -->
    <WebView
        android:id="@+id/console_webview"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

</LinearLayout>
