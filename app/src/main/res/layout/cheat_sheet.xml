<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:orientation="horizontal"
        android:background="#8B5CF6"
        android:gravity="center_vertical">
        
        <TextView
            android:id="@+id/btn_cheat_back"
            android:layout_width="55dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />
        
        <com.kenzglobe.debugmate.AppEditText
            android:id="@+id/cheat_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:gravity="center_vertical"
            android:hint="Search cheat codes..."
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:textCursorDrawable="@drawable/cursor_white"
            android:textSize="16sp"
            android:inputType="text" />
            
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DDDDDD" />

    <!-- Cheat List -->
    <ListView
        android:id="@+id/cheat_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="15dp"
        android:paddingBottom="50dp"
        android:paddingHorizontal="8dp"
        android:divider="#000000"
        android:dividerHeight="10dp"
        android:scrollbars="none"
        android:clipToPadding="false" />

</LinearLayout>
