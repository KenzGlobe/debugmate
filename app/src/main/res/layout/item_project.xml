<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/settings_section_bg"
    android:elevation="6dp"
    android:orientation="vertical"
    android:gravity="center_horizontal">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginLeft="5dp"
        android:orientation="horizontal">
        
        <TextView
            android:id="@+id/pinned"
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#888888"
            android:textSize="14sp"
            android:visibility="gone" />
        
        <TextView
            android:id="@+id/hidden"
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#888888"
            android:textSize="14sp"
            android:visibility="gone" />
        
    </LinearLayout>

    <!-- Large Centered Icon -->
    <TextView
        android:id="@+id/project_icon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="30sp" />

    <!-- Project Name -->
    <com.kenzglobe.debugmate.AppBoldTextView
        android:id="@+id/project_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <!-- Project Type (e.g. PYTHON PROJECT) -->
    <com.kenzglobe.debugmate.AppTextView
        android:id="@+id/project_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="#8B5CF6"
        android:textSize="12sp" />

    <!-- Folder Name Only -->
    <com.kenzglobe.debugmate.AppTextView
        android:id="@+id/project_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="middle"
        android:textColor="#666666"
        android:textSize="11sp" />

</LinearLayout>
