<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <!-- Black background for the popup -->
    <solid android:color="#1E1E1E" />
    
    <!-- Optional: a subtle border to make it pop -->
    <stroke android:width="1dp" android:color="#8B5CF6" />
    
    <!-- Adjust the padding so the text isn't touching the edges -->
    <padding
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp" />
</shape>